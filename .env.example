# Copie para .env.local e preencha. Nenhuma variável é obrigatória em desenvolvimento.

# URL pública do site (canonical, sitemap, Open Graph, JSON-LD).
# Precisa ser o endereço onde o site está no ar: WhatsApp e redes buscam a imagem de
# compartilhamento nela. Na Vercel/Railway é detectada sozinha; defina ao usar domínio próprio.
NEXT_PUBLIC_SITE_URL=

# API REST do WordPress que publica as notícias.
WORDPRESS_API_URL=https://pcdob.org.br/wp-json/wp/v2

# Google Analytics 4 (formato G-XXXXXXXXXX). Vazio = sem analytics e sem banner de cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Newsletter: webhook que recebe POST { email, consentAt, source }.
# Obrigatório em produção — sem ele a inscrição responde 503.
NEWSLETTER_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_TOKEN=
